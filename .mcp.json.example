{
  "_comment": "Fully-populated form. If your ops repo carries a .ops-repo-mcp.yaml (see .ops-repo-mcp.yaml.example), drop every DS_* entry below and keep only MCP_ENV_ALLOWLIST. MCP_OPS_REPO_PATH is optional: with it unset the server operates on the git repo the client was launched in, so one entry serves every ops repo.",
  "mcpServers": {
    "deploy-promote": {
      "command": "/absolute/path/to/mcp-server",
      "args": [],
      "env": {
        "MCP_OPS_REPO_PATH":   "/PATH/TO/YOUR/OPS-REPO",
        "MCP_ENV_ALLOWLIST":   "dev,staging,prod",
        "MCP_LOG_LEVEL":       "info",
        "MCP_LOCK_TIMEOUT":    "30s",
        "MCP_RUNNER_TIMEOUT":  "60s",

        "MCP_GIT_SSH_KEY_PATH": "",
        "MCP_GIT_TOKEN":        "",
        "MCP_GIT_USER":         "mcp-server",
        "MCP_GIT_EMAIL":        "mcp-server@local",

        "DS_BASE":            "base/resources",
        "DS_NAMESPACE":       "default",
        "DS_PATH_SCHEME":     "{base}/{namespace}/{app}/{env}",
        "DS_IMAGE_FILE_NAME": "deployment.yaml",
        "DS_SRC_ENV":         "staging"
      }
    }
  }
}

{
  "_comment": "Fully-populated form, for an ops repo with no .ops-repo-mcp.yaml: layout comes from the DS_* entries, and MCP_OPS_REPO_PATH must be set because a repo with no config file cannot be inferred from the working directory. If your ops repo does carry that file (see .ops-repo-mcp.yaml.example), drop every DS_* entry AND MCP_OPS_REPO_PATH, keep MCP_ENV_ALLOWLIST, and one entry then serves every ops repo you open.",
  "mcpServers": {
    "deploy-promote": {
      "command": "/absolute/path/to/ops-repo-mcp",
      "args": [],
      "env": {
        "MCP_OPS_REPO_PATH":   "/PATH/TO/YOUR/OPS-REPO",
        "MCP_ENV_ALLOWLIST":   "dev,staging,prod",
        "MCP_LOG_LEVEL":       "info",
        "MCP_LOCK_TIMEOUT":    "30s",
        "MCP_RUNNER_TIMEOUT":  "60s",

        "MCP_GIT_SSH_KEY_PATH": "",
        "MCP_GIT_TOKEN":        "",
        "MCP_GIT_USER":         "mcp-server",
        "MCP_GIT_EMAIL":        "mcp-server@local",

        "DS_BASE":            "base/resources",
        "DS_NAMESPACE":       "default",
        "DS_PATH_SCHEME":     "{base}/{namespace}/{app}/{env}",
        "DS_IMAGE_FILE_NAME": "deployment.yaml",
        "DS_SRC_ENV":         "staging"
      }
    }
  }
}
